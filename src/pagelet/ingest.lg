(ns pagelet.ingest
  (:refer-clojure :exclude [flush!])
  (:require [async :as async]
            [integrant.core :as ig]
            [json :as json]
            [pagelet.db :as db]
            [pagelet.id :as id]
            [pagelet.timezones :as timezones]
            [pagelet.ua :as ua]
            [pagelet.visitor :as visitor]
            [string :as str]))

;; Ingest: turning a tracker POST into an event or engagement row, and
;; getting rows into DuckDB in batches. A POST with a numeric `e` is an
;; engagement beacon: the milliseconds a page view was visible since its
;; previous beacon; anything else is an event.
;;
;; The request path does the minimum: parse, look the site up, classify the
;; user agent, name the country from the tracker's time zone (never from
;; the IP), and conj a row onto an in-memory buffer. It never binds
;; dynamic vars and never touches the database (let-go 1.13.0 runs every
;; handler on one shared binding stack).
;;
;; A flush loop owns every write to `events` and `engagements`. Each tick it reads the UTC
;; clock once, ensures that day's salt, takes the whole buffer, hashes each
;; row's IP and user agent into the visitor id and drops them, and inserts
;; in multi-row batches stamped with that one clock reading. The IP and
;; user agent live in memory for at most one interval and are never
;; written. The salt and the ts come from the same reading, so a row's hash
;; and its ts are always on the same UTC day.

(def ^:private max-body-bytes 4096)
(def ^:private max-props-chars 2048)
(def ^:private batch-size 200)

;; One visible stretch longer than this is a forgotten tab, not reading.
(def ^:private max-engaged-ms 1800000)

;; A buffer that cannot drain (the database is down) stops growing here;
;; later events are dropped until a flush succeeds.
(def ^:private max-buffered 100000)

(def ^:private insert-row-sql
  "(?, ?::timestamp, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)")

(def ^:private insert-engagement-sql
  "(?, ?::timestamp, ?, ?, ?)")

;; ---- parsing ------------------------------------------------------------

(defn- read-payload [body]
  (try
    (json/read-json body {:keywords? true})
    (catch Exception _ nil)))

(defn- present? [v]
  (and (string? v) (not (str/blank? v))))

(defn- event-name [n]
  (cond
    (nil? n) "pageview"
    (and (string? n) (re-matches #"[a-zA-Z0-9_-]{1,64}" n)) n
    :else nil))

(defn- find-site
  "The site a tracker's hostname belongs to: exact, or without www."
  [sites-by-domain d]
  (let [d (str/lower-case d)]
    (or (get sites-by-domain d)
        (when (str/starts-with? d "www.")
          (get sites-by-domain (subs d 4))))))

(defn- props-json
  "`p` serialised, when it is a map that fits. Never truncated: a cut JSON
   string is invalid and would fail its whole batch."
  [p]
  (when (map? p)
    (let [s (json/write-json p)]
      (when (<= (count s) max-props-chars) s))))

(defn- path-with-hash
  "The URL's path, plus the tracker's hash route in hash mode."
  [u h]
  (str (visitor/path-of u)
       (when (and (present? h) (str/starts-with? h "#")) h)))

(defn- zone-country
  "The tracker's time zone and the country it names, when the table knows
   the zone; otherwise nil for both, so no client string is stored."
  [z]
  (if-let [country (when (string? z) (get timezones/zone->country z))]
    {:timezone z :country country}
    {:timezone nil :country nil}))

(defn- engaged-ms
  "`e` as whole milliseconds, capped at max-engaged-ms (before the
   conversion, so a huge number cannot overflow it), or nil when it is not
   a number of at least 1."
  [e]
  (when (number? e)
    (let [ms (int (min e max-engaged-ms))]
      (when (>= ms 1) ms))))

(defn- from-site
  "{:drop reason} for a payload from no known site or from a bot, else
   {:ok (row site ua)}: `row` builds the row from the site and the user
   agent's classification. Every row carries the IP and the user agent for
   the flusher to hash."
  [p sites-by-domain req trust-proxy? row]
  (if-let [site (find-site sites-by-domain (:d p))]
    (let [ua-string (str (get-in req [:headers "user-agent"]))
          ua (ua/classify ua-string)]
      (if (:bot? ua)
        {:drop :bot}
        {:ok (merge {:site-id (:id site)
                     :ip (visitor/client-ip req trust-proxy?)
                     :ua ua-string
                     :path (path-with-hash (:u p) (:h p))}
                    (row site ua))}))
    {:drop :unknown-site}))

(defn parse-event
  "A tracker POST body as {:ok row}, {:drop reason} for a body that is
   ignored on purpose (unknown site, bot), or {:error message} for one that
   is not an event or an engagement. A body with an `e` key is an
   engagement beacon, whatever else it carries; its row is
   {:site-id :ip :ua :path :engaged-ms}. The row carries the IP and user
   agent for the flusher to hash; nothing is hashed here. An event's
   country comes from the payload's time zone (`z`), not from the IP."
  [body sites-by-domain req trust-proxy?]
  (let [body (str body)
        p (when (<= (count (.getBytes body)) max-body-bytes) (read-payload body))
        engagement? (and (map? p) (contains? p :e))
        n (event-name (:n p))
        ms (engaged-ms (:e p))]
    (cond
      (> (count (.getBytes body)) max-body-bytes) {:error "body too large"}
      (not (map? p)) {:error "invalid JSON"}
      (not (and (present? (:d p)) (present? (:u p)))) {:error "missing d or u"}
      engagement?
      (if ms
        (from-site p sites-by-domain req trust-proxy? (fn [_ _] {:engaged-ms ms}))
        {:error "invalid engagement"})
      (nil? n) {:error "invalid event name"}
      :else
      (from-site p sites-by-domain req trust-proxy?
                 (fn [site {:keys [browser os device]}]
                   (let [{:keys [timezone country]} (zone-country (:z p))]
                     {:name n
                      :referrer (when (string? (:r p))
                                  (visitor/referrer-host (:r p) (:domain site)))
                      :browser browser
                      :os os
                      :device device
                      :timezone timezone
                      :country country
                      :props (props-json (:p p))}))))))

;; ---- the buffer ---------------------------------------------------------

(defn refresh-sites!
  "Reload the sites cache from the database."
  [buffer]
  (reset! (:sites buffer) (db/sites-by-domain (:conn buffer))))

(defn remove-site!
  "Drop one site from the cache, so the flusher discards whatever is still
   queued for it."
  [buffer domain]
  (swap! (:sites buffer) dissoc domain))

(defn sites
  "The sites cache: domain -> site."
  [buffer]
  @(:sites buffer))

;; The write lock: a channel holding one token. A flush holds it from
;; taking the buffer to its last insert, and deleting a site holds it from
;; forgetting the site to committing the delete, so a flush that already
;; decided which sites are live can never insert after a delete. let-go
;; has no monitor locks (monitor-enter is a no-op); a blocking take on a
;; one-slot channel is the mutex.
(defn- locked [{:keys [write-lock]} f]
  (async/<!! write-lock)
  (try
    (f)
    (finally
      (async/>!! write-lock :token))))

(defn delete-site!
  "Delete `site` and its events. The cache forgets it first, so whatever is
   still queued for it is dropped; both happen under the write lock, so no
   flush in progress can write for it afterwards."
  [buffer site]
  (locked buffer
          (fn []
            (remove-site! buffer (:domain site))
            (db/delete-site! (:conn buffer) (:id site))))
  (refresh-sites! buffer))

(defn enqueue!
  "Queue a parsed row. Kicks the flusher when the buffer is full."
  [buffer row]
  (let [n (count (swap! (:events buffer)
                        (fn [rows]
                          (if (< (count rows) max-buffered) (conj rows row) rows))))]
    (when (>= n (:max-rows buffer))
      (async/offer! (:kick buffer) :kick))
    nil))

(defn- clock
  "The UTC moment a flush stamps its rows with, and its day."
  [conn]
  (db/execute-one! conn ["select (now() at time zone 'UTC')::varchar as now,
                                 (now() at time zone 'UTC')::date::varchar as day"]))

(defn- salt-for!
  "The salt for `day` (YYYY-MM-DD), from the salt atom when it holds that
   day, else from the salts table, creating it (and deleting older days)
   on the first call of a day."
  [{:keys [conn salt]} day]
  (let [cached @salt]
    (if (= day (:day cached))
      cached
      (let [select-sql ["select day::varchar as day, salt from salts where day = ?::date" day]
            row (or (db/execute-one! conn select-sql)
                    (do
                      (db/execute! conn ["insert into salts values (?::date, ?) on conflict do nothing"
                                         day (id/random-hex)])
                      (db/execute! conn ["delete from salts where day < ?::date" day])
                      (db/execute-one! conn select-sql)))]
        (reset! salt row)))))

(defn ensure-salt!
  "Make sure today's (UTC) salt exists and is in the salt atom."
  [buffer]
  (salt-for! buffer (:day (clock (:conn buffer)))))

(defn hash-rows
  "Rows with the visitor hash in place of their IP and user agent."
  [salt rows]
  (map (fn [row]
         (-> row
             (assoc :visitor (visitor/visitor-hash salt (:site-id row) (:ip row) (:ua row)))
             (dissoc :ip :ua)))
       rows))

(defn- insert-batch! [conn ts rows]
  (db/execute! conn
               (into [(str "insert into events
                            (site_id, ts, name, visitor, path, referrer, browser, os, device,
                             timezone, country, props)
                            values "
                           (str/join ", " (repeat (count rows) insert-row-sql)))]
                     (mapcat (fn [row]
                               [(:site-id row) ts (:name row) (:visitor row) (:path row)
                                (:referrer row) (:browser row) (:os row) (:device row)
                                (:timezone row) (:country row) (:props row)])
                             rows))))

(defn- insert-engagements! [conn ts rows]
  (db/execute! conn
               (into [(str "insert into engagements (site_id, ts, visitor, path, engaged_ms)
                            values "
                           (str/join ", " (repeat (count rows) insert-engagement-sql)))]
                     (mapcat (fn [row]
                               [(:site-id row) ts (:visitor row) (:path row) (:engaged-ms row)])
                             rows))))

(defn- insert-all!
  "Insert `rows` with `insert!` in batches; a batch that fails is logged and
   dropped. Returns the number of rows written."
  [insert! conn ts rows]
  (reduce (fn [written batch]
            (try
              (insert! conn ts batch)
              (+ written (count batch))
              (catch Exception e
                (println (str "pagelet: dropped " (count batch) " rows: " (ex-message e)))
                written)))
          0
          (partition-all batch-size rows)))

(defn flush!
  "Write everything buffered, in batches: events into `events`,
   engagements into `engagements`. One reading of the UTC clock
   stamps every row and picks the salt, so a flush that straddles midnight
   still hashes each row with the salt of the day its ts says. If the clock
   or the salt cannot be read, this throws before taking the buffer and the
   rows stay for the next flush. Rows for a site no longer in the cache are
   dropped; a batch that fails is logged and dropped. Returns the number of
   rows written."
  [{:keys [conn events] :as buffer}]
  (let [{:keys [now day]} (clock conn)
        salt (:salt (salt-for! buffer day))]
    (locked buffer
            (fn []
              (let [[rows _] (swap-vals! events (fn [_] []))
                    live (set (map :id (vals (sites buffer))))
                    rows (hash-rows salt (filter #(contains? live (:site-id %)) rows))
                    {engagements true events false} (group-by #(contains? % :engaged-ms) rows)]
                (+ (insert-all! insert-batch! conn now events)
                   (insert-all! insert-engagements! conn now engagements)))))))

(defn tick!
  "One flush-loop step. Never throws: a failure is printed, and one that
   happened before the buffer was taken (the clock, the salt) leaves the
   rows for the next tick."
  [buffer]
  (try
    (flush! buffer)
    (catch Exception e
      (println (str "pagelet: flush failed: " (ex-message e)))
      nil)))

(defn- start-loop!
  "Tick every interval, or sooner when kicked; on stop, tick once more and
   say so on `done`, whatever happens."
  [{:keys [stop kick done interval-ms] :as buffer}]
  (go
    (try
      (loop []
        (let [[_ ch] (async/alts!! [stop kick (async/timeout interval-ms)])]
          (tick! buffer)
          (when-not (= ch stop)
            (recur))))
      (finally
        (async/>!! done :done)))))

(defmethod ig/init-key ::buffer [_ {:keys [conn interval-ms max-rows]}]
  (let [buffer {:conn conn
                :interval-ms (or interval-ms 5000)
                :max-rows (or max-rows 500)
                :events (atom [])
                :sites (atom {})
                :salt (atom nil)
                :kick (async/chan 1)
                :stop (async/chan)
                :done (async/chan 1)
                :write-lock (doto (async/chan 1) (async/>!! :token))}]
    ;; Before the first request: a restarted server knows its sites and
    ;; has a salt. A database that cannot answer this fails ig/init.
    (refresh-sites! buffer)
    (ensure-salt! buffer)
    (start-loop! buffer)
    buffer))

;; Stop the loop and wait for its final flush. Bounded, so a wedged
;; database cannot hang shutdown. Returns :done, or nil on timeout.
(defmethod ig/halt-key! ::buffer [_ {:keys [stop done]}]
  (async/close! stop)
  (first (async/alts!! [done (async/timeout 30000)])))
