(ns pagelet.migrations
  (:require [ragtime.letgo :as rt]))

;; Schema history as ragtime migrations whose up and down steps are plain
;; SQL strings. The letgo-packages ragtime package supplies the DataStore (a
;; ragtime_migrations table) and the Migration record; this namespace holds
;; only the app's own history. Append, never edit, once a migration shipped.
;;
;; Timestamps are naive UTC: every insert writes now() at time zone 'UTC'.

(def migrations
  [(rt/sql-migration
    {:id "001-create-sites"
     :up ["create table sites (
             id varchar primary key,
             name varchar not null,
             domain varchar not null unique,
             created_at timestamp not null)"]
     :down ["drop table sites"]})

   ;; One row per page view or custom event. visitor is the daily hash
   ;; (ingest.lg); the IP and user agent are never stored.
   (rt/sql-migration
    {:id "002-create-events"
     :up ["create table events (
             site_id varchar not null,
             ts timestamp not null,
             name varchar not null,
             visitor varchar not null,
             path varchar not null,
             referrer varchar,
             browser varchar,
             os varchar,
             device varchar,
             props json)"]
     :down ["drop table events"]})

   ;; Dashboard logins.
   (rt/sql-migration
    {:id "003-create-sessions"
     :up ["create table sessions (
             id varchar primary key,
             created_at timestamp not null)"]
     :down ["drop table sessions"]})

   ;; The visitor hash salt, one row per UTC day.
   (rt/sql-migration
    {:id "004-create-salts"
     :up ["create table salts (
             day date primary key,
             salt varchar not null)"]
     :down ["drop table salts"]})

   ;; The browser's time zone and the country it names (ingest.lg), both
   ;; null when the tracker sent none the table knows, and for older rows.
   (rt/sql-migration
    {:id "005-add-events-timezone-country"
     :up ["alter table events add column timezone varchar"
          "alter table events add column country varchar"]
     :down ["alter table events drop column country"
            "alter table events drop column timezone"]})

   ;; Whether anyone may read the site's dashboard without signing in
   ;; (routes.lg, readable). Off for every site until its owner turns it on.
   ;; DuckDB takes no constraint in add column, hence a default only.
   (rt/sql-migration
    {:id "006-add-sites-public"
     :up ["alter table sites add column is_public boolean default false"]
     :down ["alter table sites drop column is_public"]})

   ;; One row per engagement beacon (ingest.lg): the milliseconds a page
   ;; view was visible since its previous beacon, a delta, so the beacons of
   ;; one page view add up. Kept apart from events, so no count over events
   ;; ever sees them. Written only by ingest.lg.
   (rt/sql-migration
    {:id "007-create-engagements"
     :up ["create table engagements (
             site_id varchar not null,
             ts timestamp not null,
             visitor varchar not null,
             path varchar not null,
             engaged_ms integer not null)"]
     :down ["drop table engagements"]})])

(defn- config [conn]
  {:datastore (rt/sql-database conn)
   :migrations migrations})

(defn migrate!
  "Apply every migration not yet applied, in order."
  [conn]
  (rt/migrate (config conn)))

(defn rollback!
  "Roll back the last migration, or the last `n`."
  ([conn] (rollback! conn 1))
  ([conn n]
   (rt/rollback (config conn) n)))
