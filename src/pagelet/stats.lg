(ns pagelet.stats
  (:require [pagelet.db :as db]
            [string :as str]))

;; The dashboard's reports: one fn per panel, each over a site and a period,
;; and `stats` putting them together in the shape the UI reads (the stats
;; response in the plan's Design; ui/src/api.ts mirrors it).
;;
;; All date work is DuckDB's. A period is built in a time zone, the
;; viewer's: its days start at that zone's midnight. It carries the naive-UTC
;; instants that filter events (:from inclusive, :to-exclusive), the naive
;; local boundaries the chart's buckets are cut from (:local-from,
;; :local-to-exclusive), the :zone, and a bucket, "hour" or "day"; the
;; bucket is interpolated into the SQL, which is safe because it only ever
;; comes from `period`, never from the request.
;;
;; DuckDB's `at time zone ?` cannot take a bound zone (it types the
;; parameter as a timestamp), so conversions use the function form:
;; timezone('UTC', timezone(zone, local)) is local -> UTC, and
;; timezone(zone, timezone('UTC', utc)) is UTC -> local. Neither depends on
;; the session's TimeZone setting.
;;
;; visitors is count(distinct visitor); pageviews counts rows named
;; 'pageview'. The visitor hash is salted per day, so a visitor is one
;; visit-day: a bounce is a visitor whose only event in the period is one
;; pageview. Each report also carries the totals of the span just before
;; it (cut at the same point when the period is still running) and whether
;; the site has any event at all, which the dashboard uses to tell a new
;; site from a quiet period.
;;
;; Visit duration and time on page read `engagements`, the tracker's
;; beacons of visible time, never `events`. Each beacon is a delta, so a
;; visitor's time is the sum of theirs. Both average over the visitors who
;; were measured: a visitor whose beacon was lost lowers neither.

(def ^:private list-limit 10)

(defn- sql-day
  "`expr` evaluated by DuckDB as a date, as YYYY-MM-DD. `expr` is SQL over
   one ?::date parameter."
  [conn expr day]
  (:d (db/execute-one! conn [(str "select (" expr ")::varchar as d") day])))

(defn zone
  "{:zone name} when `z` is a time zone DuckDB knows, or {:zone \"UTC\"}
   when it is nil or blank (no zone asked for), else {:error message}."
  [conn z]
  (cond
    (or (nil? z) (and (string? z) (= "" (str/trim z)))) {:zone "UTC"}
    (and (string? z)
         (:ok (db/execute-one! conn ["select exists(select 1 from pg_timezone_names() where name = ?) as ok" z])))
    {:zone z}
    :else {:error "tz must be an IANA time zone name"}))

(defn today
  "The current day in time zone `zone`, YYYY-MM-DD."
  [conn zone]
  (:d (db/execute-one! conn ["select timezone(?, now())::date::varchar as d" zone])))

(defn now
  "The current UTC time, YYYY-MM-DDTHH:MM:SS."
  [conn]
  (:t (db/execute-one! conn ["select strftime(now() at time zone 'UTC', '%Y-%m-%dT%H:%M:%S') as t"])))

(defn- valid-day
  "`s` when it is a real YYYY-MM-DD date, else nil."
  [conn s]
  (when (and (string? s) (re-matches #"\d{4}-\d{2}-\d{2}" s))
    (let [d (:d (db/execute-one! conn ["select try_cast(? as date)::varchar as d" s]))]
      (when (= s d) d))))

(defn- to-utc
  "The naive local time `local` (YYYY-MM-DDTHH:MM:SS) in `zone`, as naive
   UTC in the same format."
  [conn zone local]
  (:t (db/execute-one! conn ["select strftime(timezone('UTC', timezone(?, ?::timestamp)), '%Y-%m-%dT%H:%M:%S') as t"
                             zone local])))

(defn- span
  "The period from day `from` through day `to`, both inclusive, as days in
   `zone`."
  [conn zone from to bucket]
  (let [local-from (str from "T00:00:00")
        local-to (str (sql-day conn "?::date + 1" to) "T00:00:00")]
    {:from (to-utc conn zone local-from)
     :to-exclusive (to-utc conn zone local-to)
     :bucket bucket
     :zone zone
     :local-from local-from
     :local-to-exclusive local-to}))

(defn period
  "The period `params` asks for, in time zone `zone`, relative to `now-day`
   (YYYY-MM-DD, that zone's today): {:from :to-exclusive :bucket :zone
   :local-from :local-to-exclusive} or {:error message}. params: :period is
   today, 7d (the default), 30d or custom; custom takes :from and :to,
   inclusive days."
  [conn params now-day zone]
  (case (or (:period params) "7d")
    "today" (span conn zone now-day now-day "hour")
    "7d" (span conn zone (sql-day conn "?::date - 6" now-day) now-day "day")
    "30d" (span conn zone (sql-day conn "?::date - 29" now-day) now-day "day")
    "custom" (let [from (valid-day conn (:from params))
                   to (valid-day conn (:to params))]
               (cond
                 (not (and from to)) {:error "from and to must be dates, YYYY-MM-DD"}
                 (pos? (compare from to)) {:error "from must not be after to"}
                 :else (span conn zone from to (if (= from to) "hour" "day"))))
    {:error "period must be today, 7d, 30d or custom"}))

(def ^:private in-period
  "site_id = ? and ts >= ?::timestamp and ts < ?::timestamp")

(defn- in-period-params [site-id {:keys [from to-exclusive]}]
  [site-id from to-exclusive])

(defn visit-duration
  "The average visible time per measured visitor, in whole seconds; nil
   when no visitor was measured."
  [conn site-id p]
  (:s (db/execute-one! conn
                       (into [(str "select cast(round(avg(ms) / 1000) as integer) as s
                                    from (select sum(engaged_ms) as ms from engagements
                                          where " in-period "
                                          group by visitor)")]
                             (in-period-params site-id p)))))

(defn totals
  "Visitors, pageviews, views per visitor and the bounce rate (a whole
   percentage), from one row per visitor, and the visit duration."
  [conn site-id p]
  (assoc
   (db/execute-one! conn
                   (into [(str "with per_visitor as (
                                  select count(*) as events,
                                         count(*) filter (where name = 'pageview') as pageviews
                                  from events where " in-period "
                                  group by visitor)
                                select count(*) as visitors,
                                       coalesce(sum(pageviews), 0)::bigint as pageviews,
                                       case when count(*) = 0 then 0.0
                                            else round(sum(pageviews)::double / count(*), 1)
                                       end as views_per_visitor,
                                       case when count(*) = 0 then 0
                                            else cast(round(100 * (count(*) filter (where events = 1 and pageviews = 1))::double
                                                            / count(*)) as integer)
                                       end as bounce_rate
                                from per_visitor")]
                         (in-period-params site-id p)))
   :visit_duration (visit-duration conn site-id p)))

(defn- previous-period
  "The span of as many local days just before `p`, ending as far into them
   as `now` (naive UTC) is into `p`'s: {:from :to-exclusive}, naive UTC.
   The arithmetic is on naive local times, which ignore clock changes, so
   on a 23-hour day the day before still starts at its midnight."
  [conn {:keys [zone local-from local-to-exclusive]} now]
  (let [row (db/execute-one! conn ["with p as (
                                      select ?::timestamp as lf, ?::timestamp as lt,
                                             timezone(?, timezone('UTC', ?::timestamp)) as ln, ? as z)
                                    select strftime(timezone('UTC', timezone(z, lf - (lt - lf))), '%Y-%m-%dT%H:%M:%S') as f,
                                           strftime(timezone('UTC', timezone(z, least(lt, ln) - (lt - lf))), '%Y-%m-%dT%H:%M:%S') as t
                                    from p"
                                   local-from local-to-exclusive zone now zone])]
    {:from (:f row) :to-exclusive (:t row)}))

(defn previous
  "{:visitors :pageviews :visit_duration} over the span just before `p`."
  [conn site-id p now]
  (select-keys (totals conn site-id (previous-period conn p now))
               [:visitors :pageviews :visit_duration]))

(defn has-events?
  "Whether the site has any event at all."
  [conn site-id]
  (boolean (:any (db/execute-one! conn ["select exists(select 1 from events where site_id = ?) as any"
                                        site-id]))))

(def ^:private bucket-format
  {"hour" "%Y-%m-%dT%H:00"
   "day" "%Y-%m-%d"})

(defn timeseries
  "Every bucket of the period, oldest first, zero-filled. Buckets are hours
   or days in the period's zone, labelled in local time; on a fall-back day
   the repeated hour's events share one bucket."
  [conn site-id {:keys [zone local-from local-to-exclusive bucket] :as p}]
  (db/query conn
            (into [(str "with buckets as (
                           select t from generate_series(?::timestamp,
                                                         ?::timestamp - interval 1 " bucket ",
                                                         interval 1 " bucket ") as g(t)),
                         counts as (
                           select date_trunc('" bucket "', timezone(?, timezone('UTC', ts))) as t,
                                  count(distinct visitor) as visitors,
                                  count(*) filter (where name = 'pageview') as pageviews
                           from events where " in-period "
                           group by 1)
                         select strftime(b.t, '" (bucket-format bucket) "') as t,
                                coalesce(c.visitors, 0) as visitors,
                                coalesce(c.pageviews, 0) as pageviews
                         from buckets b left join counts c on c.t = b.t
                         order by b.t")
                   local-from local-to-exclusive zone]
                  (in-period-params site-id p))))

(defn- ranked
  "The top values of `column` by visitors, then pageviews, then name."
  [column]
  (fn [conn site-id p]
    (db/query conn
              (into [(str "select " column " as label,
                                  count(distinct visitor) as visitors,
                                  count(*) filter (where name = 'pageview') as pageviews
                           from events
                           where " in-period " and " column " is not null
                           group by " column "
                           order by visitors desc, pageviews desc, label
                           limit " list-limit)]
                    (in-period-params site-id p)))))

(defn- named [rows]
  (mapv (fn [row] (-> row (assoc :name (:label row)) (dissoc :label))) rows))

(def ^:private pages* (ranked "path"))
(def ^:private referrers* (ranked "referrer"))
(def ^:private countries* (ranked "country"))
(def ^:private browsers* (ranked "browser"))
(def ^:private os* (ranked "os"))
(def ^:private devices* (ranked "device"))

(defn- time-on-page
  "path -> the visible time on it per measured visitor, whole seconds."
  [conn site-id p]
  (into {}
        (map (juxt :path :time))
        (db/query conn
                  (into [(str "select path,
                                      cast(round(sum(engaged_ms) / count(distinct visitor) / 1000)
                                           as integer) as time
                               from engagements where " in-period "
                               group by path")]
                        (in-period-params site-id p)))))

(defn pages
  "The top pages, each with its :time on page (nil when not measured)."
  [conn site-id p]
  (let [times (time-on-page conn site-id p)]
    (mapv #(assoc % :time (get times (:name %)))
          (named (pages* conn site-id p)))))
(defn referrers [conn site-id p] (named (referrers* conn site-id p)))
(defn countries [conn site-id p] (named (countries* conn site-id p)))
(defn browsers [conn site-id p] (named (browsers* conn site-id p)))
(defn operating-systems [conn site-id p] (named (os* conn site-id p)))
(defn devices [conn site-id p] (named (devices* conn site-id p)))

(defn events
  "Custom events: the top names by count, then visitors, then name."
  [conn site-id p]
  (db/query conn
            (into [(str "select name, count(*) as count, count(distinct visitor) as visitors
                         from events
                         where " in-period " and name <> 'pageview'
                         group by name
                         order by count desc, visitors desc, name
                         limit " list-limit)]
                  (in-period-params site-id p))))

(defn stats
  "Every panel for `site-id` over period `p`, compared with the span before
   as of `now` (YYYY-MM-DDTHH:MM:SS, UTC). The answer's :period is in the
   period's zone, named as :tz."
  [conn site-id p now]
  {:period {:from (:local-from p) :to (:local-to-exclusive p) :bucket (:bucket p) :tz (:zone p)}
   :has_events (has-events? conn site-id)
   :totals (totals conn site-id p)
   :previous (previous conn site-id p now)
   :timeseries (timeseries conn site-id p)
   :pages (pages conn site-id p)
   :referrers (referrers conn site-id p)
   :countries (countries conn site-id p)
   :browsers (browsers conn site-id p)
   :os (operating-systems conn site-id p)
   :devices (devices conn site-id p)
   :events (events conn site-id p)})

(def ^:private last-five-minutes
  "site_id = ? and ts > (now() at time zone 'UTC') - interval 5 minute")

(defn realtime
  "{:online n :pages [...]}: distinct visitors in the last five minutes, and
   the five pages most of them viewed."
  [conn site-id]
  {:online (:online (db/execute-one! conn [(str "select count(distinct visitor) as online from events
                                                 where " last-five-minutes)
                                           site-id]))
   :pages (named (db/query conn [(str "select path as label, count(distinct visitor) as visitors
                                       from events
                                       where " last-five-minutes " and name = 'pageview'
                                       group by path
                                       order by visitors desc, label
                                       limit 5")
                                 site-id]))})
