(ns pagelet.db
  (:require [duckdb.core :as duckdb]
            [integrant.core :as ig]
            [pagelet.migrations :as migrations]
            [string :as string]))

;; The database component: a DuckDB connection with the schema migrated up
;; to date, and the queries that are not reports (stats.lg owns those).
;;
;; Queries are plain SQL strings with ? parameters. No HoneySQL: let-go
;; 1.13.0 runs every http handler on one shared dynamic-binding stack, and
;; HoneySQL binds dynamic vars while it formats.
;;
;; A DuckDB file is locked by the process that opens it; the connectable
;; wraps a database/sql pool and is safe to share between threads.

;; DUCKDB_MEMORY_LIMIT. Unset, DuckDB sizes itself from the RAM it sees,
;; which in a container with a memory limit can be far more than the
;; container may use. The setting is global to the database, so one SET
;; covers every connection in the pool. SET takes no ? parameter, so the
;; value is spliced in, and only after it is shown to be a plain size.
(def ^:private memory-limit-re
  #"\d+(\.\d+)?\s*(B|KB|MB|GB|TB|KiB|MiB|GiB|TiB)")

(defn- set-memory-limit! [conn limit]
  (when-not (re-matches memory-limit-re limit)
    (throw (ex-info (str "DUCKDB_MEMORY_LIMIT must be a size like 128MB or 1GiB, got: " (pr-str limit))
                    {:memory-limit limit})))
  (duckdb/execute! conn [(str "SET memory_limit = '" limit "'")]))

(defmethod ig/init-key ::conn [_ {:keys [path memory-limit]}]
  (let [conn (duckdb/open path)]
    ;; A failed init must not keep the file locked.
    (try
      (when-not (string/blank? (str memory-limit))
        (set-memory-limit! conn memory-limit))
      (migrations/migrate! conn)
      conn
      (catch Throwable e
        (duckdb/close! conn)
        (throw e)))))

(defmethod ig/halt-key! ::conn [_ conn]
  (duckdb/close! conn))

(def query duckdb/query)
(def execute! duckdb/execute!)
(def execute-one! duckdb/execute-one!)

(defn sites
  "Every site, ordered by name."
  [conn]
  (query conn ["select id, name, domain, strftime(created_at, '%Y-%m-%dT%H:%M:%S') as created_at
                from sites order by name, domain"]))

(defn sites-by-domain
  "Every site keyed by its domain: the ingest's lookup table."
  [conn]
  (into {} (map (juxt :domain identity)) (sites conn)))

;; ---- sites --------------------------------------------------------------

(def ^:private site-columns
  "id, name, domain, strftime(created_at, '%Y-%m-%dT%H:%M:%S') as created_at")

(defn site-by-id [conn id]
  (execute-one! conn [(str "select " site-columns " from sites where id = ?") id]))

(defn site-by-domain [conn domain]
  (execute-one! conn [(str "select " site-columns " from sites where domain = ?") domain]))

(defn create-site! [conn id name domain]
  (execute-one! conn [(str "insert into sites values (?, ?, ?, now() at time zone 'UTC')
                            returning " site-columns)
                      id name domain]))

(defn update-site! [conn id name domain]
  (execute-one! conn [(str "update sites set name = ?, domain = ? where id = ?
                            returning " site-columns)
                      name domain id]))

(defn delete-site!
  "Delete a site and every event it has, in one transaction."
  [conn id]
  (duckdb/with-transaction [tx conn]
    (execute! tx ["delete from events where site_id = ?" id])
    (execute! tx ["delete from sites where id = ?" id])))

;; ---- sessions -----------------------------------------------------------

(defn create-session! [conn id]
  (execute! conn ["insert into sessions values (?, now() at time zone 'UTC')" id]))

(defn session-live?
  "Whether `id` is a session younger than `days` days."
  [conn id days]
  (some? (execute-one! conn ["select id from sessions
                              where id = ?
                                and created_at > (now() at time zone 'UTC') - to_days(?)"
                             id days])))

(defn delete-session! [conn id]
  (execute! conn ["delete from sessions where id = ?" id]))
