(ns pagelet.db
  (:require [duckdb.core :as duckdb]
            [integrant.core :as ig]
            [pagelet.migrations :as migrations]))

;; The database component: a DuckDB connection with the schema migrated up
;; to date, and the queries that are not reports (stats.lg owns those).
;;
;; Queries are plain SQL strings with ? parameters. No HoneySQL: let-go
;; 1.13.0 runs every http handler on one shared dynamic-binding stack, and
;; HoneySQL binds dynamic vars while it formats.
;;
;; A DuckDB file is locked by the process that opens it; the connectable
;; wraps a database/sql pool and is safe to share between threads.

(defmethod ig/init-key ::conn [_ {:keys [path]}]
  (let [conn (duckdb/open path)]
    (migrations/migrate! conn)
    conn))

(defmethod ig/halt-key! ::conn [_ conn]
  (duckdb/close! conn))

(def query duckdb/query)
(def execute! duckdb/execute!)
(def execute-one! duckdb/execute-one!)

(defn sites
  "Every site, ordered by name."
  [conn]
  (query conn ["select id, name, domain, created_at::varchar as created_at
                from sites order by name, domain"]))
